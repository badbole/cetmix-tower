<?xml version="1.0" encoding="utf-8" ?>
<odoo>

    <!-- User Access -->
    <record id="cx_tower_server_rule_group_user_visibility" model="ir.rule">
        <field name="name">Tower Server: user visibility rule</field>
        <field name="model_id" ref="model_cx_tower_server" />
        <field name="groups" eval="[(4, ref('group_user'))]" />
            <field
            name="domain_force"
        >[('message_partner_ids', 'in', [user.partner_id.id])]</field>
    </record>

    <!-- Manager Access -->
    <!-- Rule 1: Read access if the current user is a follower or is in manager_ids -->
    <record id="ir_rule_cx_tower_server_manager_read" model="ir.rule">
        <field
            name="name"
        >cx.tower.server: Manager Read (if follower or in manager_ids)</field>
        <field name="model_id" ref="model_cx_tower_server" />
        <field name="groups" eval="[(4, ref('cetmix_tower_server.group_manager'))]" />
        <!-- allow read if the user’s partner is among the followers OR if the user is in manager_ids -->
        <field name="domain_force">
            ['|', ('message_partner_ids', 'in', [user.partner_id.id]),
            ('manager_ids', 'in', [user.id])]
        </field>
        <field name="perm_read" eval="1" />
        <field name="perm_write" eval="0" />
        <field name="perm_create" eval="0" />
        <field name="perm_unlink" eval="0" />
    </record>

    <!-- Rule 2: Write and Create access if the current user is in manager_ids -->
    <record id="ir_rule_cx_tower_server_manager_write_create" model="ir.rule">
        <field
            name="name"
        >cx.tower.server: Manager Write &amp; Create (if in manager_ids)</field>
        <field name="model_id" ref="model_cx_tower_server" />
        <field name="groups" eval="[(4, ref('cetmix_tower_server.group_manager'))]" />
        <!-- allow write/create only if the user is in the manager_ids many2many field -->
        <field name="domain_force">[('manager_ids', 'in', [user.id])]</field>
        <field name="perm_read" eval="0" />
        <field name="perm_write" eval="1" />
        <field name="perm_create" eval="1" />
        <field name="perm_unlink" eval="0" />
    </record>

    <!-- Rule 3: Delete access if the current user is in manager_ids and is the creator -->
    <record id="ir_rule_cx_tower_server_manager_unlink" model="ir.rule">
        <field
            name="name"
        >cx.tower.server: Manager Delete (if in manager_ids and creator)</field>
        <field name="model_id" ref="model_cx_tower_server" />
        <field name="groups" eval="[(4, ref('cetmix_tower_server.group_manager'))]" />
        <!-- allow deletion only if the user is in manager_ids and he is the record creator -->
        <field
            name="domain_force"
        >[('manager_ids', 'in', [user.id]), ('create_uid', '=', user.id)]</field>
        <field name="perm_read" eval="0" />
        <field name="perm_write" eval="0" />
        <field name="perm_create" eval="0" />
        <field name="perm_unlink" eval="1" />
    </record>


    <!-- Root Access -->
    <record id="cx_tower_server_rule_group_root_visibility" model="ir.rule">
        <field name="name">Tower Server: root visibility rule</field>
        <field name="model_id" ref="model_cx_tower_server" />
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4,ref('group_root'))]" />
    </record>

</odoo>
